#!/usr/bin/env bash
# Minimal ET-backed implementation of ETTUN_TRANSPORT's legacy and v2 APIs.

set -u

if [[ ${1:-} == --ettun-capabilities ]]; then
  (($# == 1)) || exit 2
  printf '%s\n' connect-v2
  exit 0
fi

reverse_tunnel_spec=
if (($# == 3)); then
  via_host=$1
  tunnel_spec=$2
  remote_command=$3
elif (($# == 5)) && [[ $1 == --ettun-connect-v2 ]]; then
  via_host=$2
  tunnel_spec=$3
  reverse_tunnel_spec=$4
  remote_command=$5
else
  printf '%s\n' \
    'usage: transport-et-wrapper VIA TUNNEL_SPEC REMOTE_COMMAND' \
    '       transport-et-wrapper --ettun-connect-v2 VIA TUNNEL_SPEC REVERSE_SPEC REMOTE_COMMAND' \
    >&2
  exit 2
fi
et_name=${ETTUN_ET:-et}
# Mirror ettun's stock ET invocation. Long options mean the same in ET 7.0 and
# 7.1, --no-persist stops ET 7.1 saving a session it cannot reattach with its
# forwards, and the terminal path starts the remote login shell with NO_TMUX=1
# so a startup file can skip a tmux attach before ET types the remote command.
et_argv=(--no-terminal --no-persist --keepalive 5
  --terminal-path 'env NO_TMUX=1 etterminal')

# Resolve one executable instead of evaluating a command string. An adapter is
# trusted code and receives the generated bootstrap command, but it should not
# turn that trust into an extra shell-evaluation boundary of its own.
if ! et_path=$(command -v "$et_name" 2>/dev/null); then
  printf "transport-et-wrapper: ET client '%s' was not found\n" "$et_name" >&2
  exit 127
fi

# Build each ET option as a distinct argv element. An empty mapping is omitted;
# ettun's v2 invocation always supplies its private control mapping in the
# ordinary tunnel specification, while the reverse specification is optional.
[[ -z $tunnel_spec ]] || et_argv+=(--tunnel "$tunnel_spec")
[[ -z $reverse_tunnel_spec ]] ||
  et_argv+=(--reversetunnel "$reverse_tunnel_spec")
et_argv+=(--command "$remote_command" "$via_host")

# Stay in the foreground, retain the caller's standard input for interactive
# authentication, and let exec preserve ET's signals and exit status exactly.
# ETTUN_RETRY_MARKER remains in the environment; retry classification still
# belongs to ettun and depends on the tokenized remote diagnostic on stderr.
exec "$et_path" "${et_argv[@]}"
