#!/usr/bin/env bash
# ettun-custom-test - custom transport and job-control behavior.

# shellcheck disable=SC2016,SC2154
# shellcheck source=ettun-fixture.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/ettun-fixture.sh"

echo "=== ettun custom transport ==="

ETTUN_TEST_LSOF_EXIT=1 ETTUN_TEST_TRANSPORT="$bin/test-transport" \
  _run_ettun relay.example 5901 desktop.internal 5900
unset ETTUN_TEST_TRANSPORT
commands=$(cat "$log")

_assert_exit "custom transport: succeeds" 0 "$run_exit"
_assert_contains "custom transport: receives via host first" $'transport\n<relay.example>' "$commands"
_assert_contains "custom transport: receives the complete ET tunnel spec second" \
  $'<relay.example>\n<5901:' "$commands"
_assert_contains "custom transport: receives the bounded bootstrap third" \
  "et-bootstrap" "$commands"
_assert_not_contains "custom transport: bypasses the default ET binary" $'\net\n' "$commands"

ETTUN_TEST_LSOF_EXIT=1 ETTUN_TEST_TRANSPORT="$bin/test-transport" \
  _run_ettun relay.example --reverse 22022 127.0.0.1 22
unset ETTUN_TEST_TRANSPORT
commands=$(cat "$log")
_assert_exit "reverse adapter: legacy contract is rejected before connect" \
  1 "$run_exit"
_assert_not_contains "reverse adapter: unsupported adapter opens no connection" \
  '<--ettun-connect-v2>' "$commands"

ETTUN_TEST_LSOF_EXIT=1 ETTUN_TEST_TRANSPORT="$bin/v2-transport" \
  _run_ettun relay.example \
  --local 5904 desktop.internal 5900 \
  --reverse 22023 127.0.0.1 22
unset ETTUN_TEST_TRANSPORT
commands=$(cat "$log")
_assert_exit "v2 adapter: mixed routes succeed" 0 "$run_exit"
_assert_contains "v2 adapter: capability is checked before connect" \
  'capability-query' "$commands"
_assert_contains "v2 adapter: selects the versioned operation" \
  $'transport-v2\n<--ettun-connect-v2>\n<relay.example>' "$commands"
_assert_contains "v2 adapter: receives local mappings separately" \
  $'<relay.example>\n<5904:' "$commands"
_assert_contains "v2 adapter: receives the reverse mapping separately" \
  $'<127.0.0.1:' "$commands"
_assert_contains "v2 adapter: reverse target remains an argv field" \
  ':127.0.0.1:22>' "$commands"

# The checked-in adapter is documentation only if it is not exercised through
# ettun's real custom-transport path. Use the fixture ET binary so the test can
# prove argv forwarding without opening a network connection.
example_adapter="$ETTUN_TEST_ROOT/examples/transport-et-wrapper"
ETTUN_TEST_LSOF_EXIT=1 ETTUN_TEST_ET="$bin/et" \
  ETTUN_TEST_TRANSPORT="$example_adapter" \
  _run_ettun relay.example 5903 desktop.example 5900
unset ETTUN_TEST_TRANSPORT ETTUN_TEST_ET
commands=$(cat "$log")
_assert_exit "transport example: succeeds through the public adapter contract" \
  0 "$run_exit"
_assert_contains "transport example: invokes the selected ET executable" \
  $'et\n<-N>\n<--keepalive>\n<5>\n<-t>\n<5903:' "$commands"
_assert_contains "transport example: forwards the generated remote command" \
  "<--command>" "$commands"

example_capabilities=$("$example_adapter" --ettun-capabilities)
_assert_eq "transport example: declares the versioned connect contract" \
  connect-v2 "$example_capabilities"
ETTUN_TEST_LSOF_EXIT=1 ETTUN_TEST_ET="$bin/et" \
  ETTUN_TEST_TRANSPORT="$example_adapter" \
  _run_ettun relay.example \
  --local 5905 desktop.example 5900 \
  --reverse 22024 127.0.0.1 22
unset ETTUN_TEST_TRANSPORT ETTUN_TEST_ET
commands=$(cat "$log")
_assert_exit "transport example: supports a mixed route" 0 "$run_exit"
_assert_contains "transport example: forwards the reverse mapping" \
  $'<-r>\n<127.0.0.1:' "$commands"

# A wrapper must not consume authentication input or hide the transport's real
# status. Exercise the example directly with a tiny ET-compatible test double.
example_stdin="$tmp/example-stdin"
example_args="$tmp/example-args"
_write_stub "$bin/example-et" \
  'printf "%s\n" "$@" >"$ETTUN_TEST_EXAMPLE_ARGS"' \
  'IFS= read -r line || true' \
  'printf "%s\n" "$line" >"$ETTUN_TEST_EXAMPLE_STDIN"' \
  'exit 37'
set +e
printf 'interactive-auth\n' |
  ETTUN_ET="$bin/example-et" \
    ETTUN_TEST_EXAMPLE_ARGS="$example_args" \
    ETTUN_TEST_EXAMPLE_STDIN="$example_stdin" \
    "$example_adapter" gateway.example '5903:45000,45001:45002' 'remote command'
example_exit=$?
set -e
_assert_exit "transport example: preserves the ET exit status" 37 "$example_exit"
_assert_eq "transport example: leaves standard input attached" \
  "interactive-auth" "$(<"$example_stdin")"
_assert_eq "transport example: passes the complete ET invocation" \
  $'-N\n--keepalive\n5\n-t\n5903:45000,45001:45002\n--command\nremote command\ngateway.example' \
  "$(<"$example_args")"

set +e
printf 'interactive-auth-v2\n' |
  ETTUN_ET="$bin/example-et" \
    ETTUN_TEST_EXAMPLE_ARGS="$example_args" \
    ETTUN_TEST_EXAMPLE_STDIN="$example_stdin" \
    "$example_adapter" --ettun-connect-v2 gateway.example \
    '5905:45003,45004:45005' '127.0.0.1:45006:127.0.0.1:22' \
    'remote command v2'
example_exit=$?
set -e
_assert_exit "transport example v2: preserves the ET exit status" 37 \
  "$example_exit"
_assert_eq "transport example v2: leaves standard input attached" \
  "interactive-auth-v2" "$(<"$example_stdin")"
_assert_eq "transport example v2: passes both ET mappings" \
  $'-N\n--keepalive\n5\n-t\n5905:45003,45004:45005\n-r\n127.0.0.1:45006:127.0.0.1:22\n--command\nremote command v2\ngateway.example' \
  "$(<"$example_args")"

ETTUN_TEST_LSOF_EXIT=1 ETTUN_TEST_TRANSPORT="$bin/test-transport" \
  _run_ettun __ettun_transport_worker 5902 desktop.internal 5900
unset ETTUN_TEST_TRANSPORT
commands=$(cat "$log")
_assert_exit "custom transport: a worker-like VIA remains usable" 0 "$run_exit"
_assert_contains "custom transport: passes a worker-like VIA unchanged" \
  $'transport\n<__ettun_transport_worker>' "$commands"

worker_runtime="$tmp/worker-runtime"
worker_pgrps="$tmp/worker-pgrps"
worker_bash_env="$tmp/worker-bash-env"
mkdir -p "$worker_runtime"
printf 'set -m\n' >"$worker_bash_env"
worker_exit=0
PATH="$bin:$test_extended_system_path" \
  BASH_ENV="$worker_bash_env" \
  ETTUN_TEST_WORKER_PGRPS="$worker_pgrps" \
  "$BASH" "$SCRIPT" --ettun-transport-worker \
  "$worker_runtime" 0 "$bin/worker-pgrp-transport" "" \
  gateway.example 5902:5900 "" true "$$" || worker_exit=$?
_assert_exit "transport worker: succeeds with inherited monitor mode" 0 "$worker_exit"
if [[ -r "$worker_pgrps" ]]; then
  read -r worker_pgid adapter_pgid <"$worker_pgrps"
else
  worker_pgid=missing
  adapter_pgid=absent
fi
_assert_eq "transport worker: keeps the adapter in its process group" \
  "$worker_pgid" "$adapter_pgid"

tstp_exit_runtime="$tmp/tstp-exit-runtime"
mkdir -p "$tstp_exit_runtime"
tstp_exit=0
PATH="$bin:$test_extended_system_path" \
  "$test_python" - "$BASH" "$SCRIPT" "$tstp_exit_runtime" \
  "$bin/tstp-exit-transport" <<'PY' || tstp_exit=$?
import os
import subprocess
import sys

bash, script, runtime, transport = sys.argv[1:]
completed = subprocess.run(
    [
        bash,
        script,
        "--ettun-transport-worker",
        runtime,
        "0",
        transport,
        "",
        "gateway.example",
        "5902:5900",
        "",
        "true",
        str(os.getpid()),
    ],
    check=False,
    start_new_session=True,
    timeout=10,
)
raise SystemExit(completed.returncode)
PY
_assert_exit "transport worker: preserves exit 127 after Ctrl-Z" 127 "$tstp_exit"

publication_runtime="$tmp/publication-runtime"
publication_bin="$tmp/publication-bin"
publication_marker="$tmp/publication.marker"
publication_release="$tmp/publication.release"
mkdir -p "$publication_runtime" "$publication_bin"
# This mv performs the real atomic publication, then stops the whole process
# group and blocks. The parent test withholds release long enough to prove that
# seeing transport.status cannot make the worker return before reaping the
# wrapper. The marker records that wrapper PID for the final no-orphan check.
_write_stub "$publication_bin/mv" \
  "real_mv=$real_mv_q" \
  '"$real_mv" "$@"' \
  'kill -TSTP 0' \
  'printf "%s\n" "$PPID" >"$ETTUN_TEST_PUBLISHER_MARKER"' \
  'while [[ ! -e "$ETTUN_TEST_PUBLISHER_RELEASE" ]]; do sleep 0.01; done'
publication_exit=0
PATH="$publication_bin:$bin:$test_extended_system_path" \
  ETTUN_TEST_PUBLISHER_MARKER="$publication_marker" \
  ETTUN_TEST_PUBLISHER_RELEASE="$publication_release" \
  "$test_python" - "$BASH" "$SCRIPT" "$publication_runtime" \
  "$bin/exit-127-transport" "$publication_marker" "$publication_release" <<'PY' || publication_exit=$?
import os
import signal
import subprocess
import sys
import time

bash, script, runtime, transport, marker, release = sys.argv[1:]
worker = subprocess.Popen(
    [
        bash,
        script,
        "--ettun-transport-worker",
        runtime,
        "0",
        transport,
        "",
        "gateway.example",
        "5902:5900",
        "",
        "true",
        str(os.getpid()),
    ],
    start_new_session=True,
)
deadline = time.monotonic() + 5
while not os.path.exists(marker) and time.monotonic() < deadline:
    time.sleep(0.01)
marker_seen = os.path.exists(marker)
time.sleep(0.1)
returned_before_release = worker.poll() is not None
open(release, "wb").close()
try:
    returncode = worker.wait(timeout=5)
except subprocess.TimeoutExpired:
    os.killpg(worker.pid, signal.SIGKILL)
    returncode = worker.wait(timeout=1)

publisher_gone = False
try:
    with open(marker, "r", encoding="utf-8") as marker_input:
        publisher_pid = int(marker_input.read().strip())
except (FileNotFoundError, ValueError):
    publisher_pid = None
if publisher_pid is not None:
    deadline = time.monotonic() + 2
    while time.monotonic() < deadline:
        try:
            os.kill(publisher_pid, 0)
        except ProcessLookupError:
            publisher_gone = True
            break
        time.sleep(0.01)

success = marker_seen and not returned_before_release and returncode == 127 and publisher_gone
if not success:
    sys.stderr.write(
        f"marker={marker_seen} early={returned_before_release} "
        f"exit={returncode} publisher_gone={publisher_gone}\n"
    )
sys.exit(0 if success else 1)
PY
_assert_exit "transport worker: reaps the status publisher before returning" \
  0 "$publication_exit"

gate_runtime_root="$tmp/gate-runtime"
gate_adapter_pid="$tmp/gate-adapter.pid"
gate_results="$tmp/gate-results"
gate_bin="$tmp/gate-bin"
gate_bash_env="$tmp/gate-bash-env"
mkdir -p "$gate_runtime_root" "$gate_bin"
_write_stub "$gate_bin/ps" \
  'for arg in "$@"; do' \
  '  if [[ "$arg" == tpgid= ]]; then' \
  '    if [[ -n "${ETTUN_TEST_PROBE_HELD:-}" ]]; then' \
  '      : >"$ETTUN_TEST_PROBE_HELD"' \
  '      # The helper ignores common signals, so retain an abnormal-exit bound.' \
  '      probe_wait=0' \
  '      while [[ ! -e "$ETTUN_TEST_PROBE_RELEASE" ]] && ((probe_wait < 600)); do' \
  '        sleep 0.05' \
  '        probe_wait=$((probe_wait + 1))' \
  '      done' \
  '    fi' \
  '    sleep 0.05' \
  '    exit 1' \
  '  fi' \
  'done' \
  "exec $real_ps_q \"\$@\""
# Bash 3.2 sources BASH_ENV before making the script's positional parameters
# available. Classify on the first script command instead: ordinary Bash
# subprocesses remove the DEBUG trap immediately, while the sentinel worker
# retains it until its internal function call, before worker signal traps run.
_write_stub "$gate_bash_env" \
  'if [[ -n "${ETTUN_TEST_WORKER_START_MODE:-}${ETTUN_TEST_GATE_TIMEOUT:-}" ]]; then' \
  "  trap '" \
  '    if [[ "$BASH_COMMAND" == run_transport_worker\ * ]]; then' \
  '      trap - DEBUG' \
  '      if [[ -n "${ETTUN_TEST_GATE_TIMEOUT:-}" ]]; then' \
  '        FOREGROUND_GATE_TIMEOUT="$ETTUN_TEST_GATE_TIMEOUT"' \
  '      fi' \
  '      case "$ETTUN_TEST_WORKER_START_MODE" in' \
  '        block)' \
  '          : >"$ETTUN_TEST_WORKER_BLOCKED"' \
  '          IFS= read -r _ <"$ETTUN_TEST_WORKER_GATE"' \
  '          ;;' \
  '        exit) exit 42 ;;' \
  '      esac' \
  '    elif [[ "${1:-}" != --ettun-transport-worker ]]; then' \
  '      trap - DEBUG' \
  '    fi' \
  "  ' DEBUG" \
  'fi'
gate_exit=0
PATH="$gate_bin:$bin:$test_extended_system_path" \
  TMPDIR="$gate_runtime_root" \
  HOME="$test_home" \
  XDG_STATE_HOME="$test_home/state" \
  BASH_ENV="$gate_bash_env" \
  ETTUN_CLIENT_ID=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa \
  ETTUN_TEST_TRANSPORT_PID="$gate_adapter_pid" \
  ETTUN_TRANSPORT="$bin/interactive-transport" \
  "$test_python" - "$BASH" "$SCRIPT" "$gate_runtime_root" \
  "$gate_adapter_pid" "$gate_results" <<'PY' || gate_exit=$?
import fcntl
import os
import pty
import select
import signal
import sys
import termios
import time

bash, script, runtime_root, adapter_pid_file, results_file = sys.argv[1:]

def transport_worker_state():
    for entry in os.listdir(runtime_root):
        run_dir = os.path.join(runtime_root, entry)
        pid_path = os.path.join(run_dir, "transport.pid")
        try:
            with open(pid_path, "r", encoding="utf-8") as pid_input:
                worker_pid = int(pid_input.read().strip())
        except (FileNotFoundError, ValueError):
            pass
        else:
            return worker_pid, os.path.exists(os.path.join(run_dir, "transport.ready"))
    return None, False

def reap_child(pid, timeout):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        try:
            waited, status = os.waitpid(pid, os.WNOHANG)
        except ChildProcessError:
            return True, None
        if waited:
            return True, status
        time.sleep(0.05)
    return False, None

def run_case(port, cancel=False, startup_mode=""):
    try:
        os.unlink(adapter_pid_file)
    except FileNotFoundError:
        pass
    blocked_marker = f"{results_file}.{port}.blocked"
    gate_fifo = f"{results_file}.{port}.gate"
    probe_held = f"{results_file}.{port}.probe-held"
    probe_release = f"{results_file}.{port}.probe-release"
    if startup_mode == "block":
        os.mkfifo(gate_fifo)
    # The gate is meaningful only with a controlling PTY: without one, the
    # worker deliberately skips foreground ownership and starts immediately.
    master, slave = pty.openpty()
    child = os.fork()
    if child == 0:
        os.setsid()
        fcntl.ioctl(slave, termios.TIOCSCTTY, 0)
        for fd in (0, 1, 2):
            os.dup2(slave, fd)
        os.close(master)
        os.close(slave)
        environment = os.environ.copy()
        environment.update(
            {
                "ETTUN_TEST_WORKER_START_MODE": startup_mode,
                "ETTUN_TEST_WORKER_BLOCKED": blocked_marker,
                "ETTUN_TEST_WORKER_GATE": gate_fifo,
            }
        )
        if cancel and not startup_mode:
            # Keep the worker's own gate deadline beyond this case's 20-second
            # test bound so it cannot replace the cancellation outcome.
            environment.update(
                {
                    "ETTUN_TEST_GATE_TIMEOUT": "30",
                    "ETTUN_TEST_PROBE_HELD": probe_held,
                    "ETTUN_TEST_PROBE_RELEASE": probe_release,
                }
            )
        os.execve(
            bash,
            ["bash", script, "gateway.example", str(port), "service.internal", "443"],
            environment,
        )

    os.close(slave)
    output = b""
    status = None
    reaped = False
    cancel_sent = False
    blocked_seen = False
    probe_held_seen = False
    ready_before_cancel = False
    launcher_foreground = False
    worker_foreground = False
    worker_pid = None
    deadline = time.monotonic() + (5 if startup_mode else 20)
    try:
        while time.monotonic() < deadline:
            readable, _, _ = select.select([master], [], [], 0.05)
            if readable:
                try:
                    output += os.read(master, 4096)
                except OSError:
                    pass
            worker_pid, worker_ready = transport_worker_state()
            if cancel and not cancel_sent and worker_pid is not None:
                try:
                    terminal_pgid = os.tcgetpgrp(master)
                    launcher_foreground = terminal_pgid == child
                    worker_foreground = terminal_pgid == worker_pid
                    probe_held_seen = os.path.exists(probe_held)
                    if startup_mode == "block" and os.path.exists(blocked_marker):
                        blocked_seen = True
                        ready_before_cancel = worker_ready
                        os.write(master, b"\x03")
                        cancel_sent = True
                    # The normal gate case covers cancellation after the worker
                    # really owns the terminal. The startup case above instead
                    # requires Ctrl-C to remain with the launcher.
                    # Keep the deliberately broken foreground probe parked
                    # while cancellation is observed. Otherwise its independent
                    # ten-second deadline can overtake this PTY write on a busy
                    # runner and turn the fixture into a race between failures.
                    elif (
                        not startup_mode
                        and worker_ready
                        and worker_foreground
                        and probe_held_seen
                    ):
                        ready_before_cancel = worker_ready
                        os.write(master, b"\x03")
                        cancel_sent = True
                except OSError:
                    pass
            waited, candidate = os.waitpid(child, os.WNOHANG)
            if waited:
                status = candidate
                reaped = True
                break
    finally:
        open(probe_release, "ab").close()
        if status is None:
            if worker_pid is not None:
                try:
                    os.killpg(worker_pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
            try:
                os.killpg(child, signal.SIGKILL)
            except ProcessLookupError:
                pass
            reaped, status = reap_child(child, 1)
            if not reaped:
                try:
                    os.kill(child, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                reaped, status = reap_child(child, 1)
        os.close(master)

    exit_code = os.waitstatus_to_exitcode(status) if status is not None else None
    adapter_started = os.path.exists(adapter_pid_file)
    return {
        "adapter": adapter_started,
        "blocked": blocked_seen,
        "cancel_sent": cancel_sent,
        "exit": exit_code,
        "foreground": worker_foreground,
        "launcher_foreground": launcher_foreground,
        "output": output,
        "probe_held": probe_held_seen,
        "ready": ready_before_cancel,
        "reaped": reaped,
        "runtime_clean": not os.listdir(runtime_root),
    }

bounded_case = run_case(10454)
cancel_case = run_case(10455, cancel=True)
startup_cancel_case = run_case(10456, cancel=True, startup_mode="block")
startup_exit_case = run_case(10457, startup_mode="exit")
bounded = (
    bounded_case["exit"] == 1
    and bounded_case["reaped"]
    and not bounded_case["adapter"]
    and b"could not hand the terminal" in bounded_case["output"]
)
cancelled = (
    cancel_case["cancel_sent"]
    and cancel_case["exit"] == 130
    and cancel_case["reaped"]
    and cancel_case["probe_held"]
    and cancel_case["ready"]
    and not cancel_case["adapter"]
)
startup_cancelled = (
    startup_cancel_case["blocked"]
    and startup_cancel_case["cancel_sent"]
    and startup_cancel_case["exit"] == 130
    and startup_cancel_case["reaped"]
    and startup_cancel_case["runtime_clean"]
    and not startup_cancel_case["adapter"]
    and not startup_cancel_case["ready"]
    and not startup_cancel_case["foreground"]
    and startup_cancel_case["launcher_foreground"]
)
startup_exit_preserved = (
    startup_exit_case["exit"] == 42
    and startup_exit_case["reaped"]
    and startup_exit_case["runtime_clean"]
    and not startup_exit_case["adapter"]
)
with open(results_file, "w", encoding="utf-8") as results:
    results.write(f"bounded={int(bounded)}\n")
    results.write(f"cancelled={int(cancelled)}\n")
    results.write(f"startup_cancelled={int(startup_cancelled)}\n")
    results.write(f"startup_exit_preserved={int(startup_exit_preserved)}\n")
if not bounded:
    sys.stderr.write(f"bounded: {bounded_case}\n")
    sys.stderr.buffer.write(bounded_case["output"])
if not cancelled:
    sys.stderr.write(f"cancellation: {cancel_case}\n")
    sys.stderr.buffer.write(cancel_case["output"])
if not startup_cancelled:
    sys.stderr.write(f"startup cancellation: {startup_cancel_case}\n")
    sys.stderr.buffer.write(startup_cancel_case["output"])
if not startup_exit_preserved:
    sys.stderr.write(f"startup exit: {startup_exit_case}\n")
    sys.stderr.buffer.write(startup_exit_case["output"])
sys.exit(0 if all((bounded, cancelled, startup_cancelled, startup_exit_preserved)) else 1)
PY
_assert_exit "terminal gate: a failed foreground probe is bounded" 0 "$gate_exit"
if [[ -r "$gate_results" ]]; then
  gate_result_text=$(cat "$gate_results")
else
  gate_result_text=""
fi
_assert_contains "terminal gate: reports foreground handoff failure" \
  "bounded=1" "$gate_result_text"
_assert_contains "terminal gate: cancellation launches no adapter" \
  "cancelled=1" "$gate_result_text"
_assert_contains "terminal gate: startup Ctrl-C stays with the launcher until traps are armed" \
  "startup_cancelled=1" "$gate_result_text"
_assert_contains "terminal gate: preserves a worker failure before readiness" \
  "startup_exit_preserved=1" "$gate_result_text"

# Exercise a real controlling PTY rather than piping input. macOS Bash job
# control differs from noninteractive subprocess behavior: Ctrl-Z is terminal
# input, foreground PGID determines signal delivery, and fg restores termios.
interactive_transport_pid_file="$tmp/interactive-transport.pid"
interactive_auth_result="$tmp/interactive-auth.result"
interactive_auth_state="$tmp/interactive-auth.state"
interactive_resume_marker="$tmp/interactive-resumed"
interactive_exit=0
PATH="$bin:$test_extended_system_path" \
  HOME="$test_home" \
  XDG_STATE_HOME="$test_home/state" \
  ETTUN_CLIENT_ID=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa \
  ETTUN_TEST_TRANSPORT_PID="$interactive_transport_pid_file" \
  ETTUN_TEST_AUTH_RESULT="$interactive_auth_result" \
  ETTUN_TEST_AUTH_STATE="$interactive_auth_state" \
  ETTUN_TEST_PYTHON="$test_python" \
  ETTUN_TEST_RESUME_MARKER="$interactive_resume_marker" \
  ETTUN_TRANSPORT="$bin/interactive-transport" \
  "$test_python" - "$BASH" "$SCRIPT" "$interactive_transport_pid_file" \
  "$interactive_auth_result" "$interactive_auth_state" \
  "$interactive_resume_marker" <<'PY' || interactive_exit=$?
import fcntl
import os
import pty
import select
import signal
import subprocess
import sys
import termios
import time

bash, script, transport_pid_file, auth_result, auth_state, resume_marker = sys.argv[1:]

def reap_child(pid, timeout):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        try:
            waited, _ = os.waitpid(pid, os.WNOHANG)
        except ChildProcessError:
            return True
        if waited:
            return True
        time.sleep(0.05)
    return False

def wait_process_gone(pid, timeout):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        state = subprocess.run(
