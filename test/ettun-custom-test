  0 "$interactive_handoff_exit"
_assert_file_exists "interactive handoff: forces a pre-attachment transport stop" \
  "$interactive_pre_auth_stopped"

# Simulate the narrow case where the worker records Ctrl-C and dies after control
# handoff but before the launcher's wait has reaped it. The marker must dominate
# the transient wait status, and the adapter process group must still disappear.
late_interrupt_transport_pid="$tmp/late-interrupt-transport.pid"
late_interrupt_auth_result="$tmp/late-interrupt-auth.result"
late_interrupt_control_token="$tmp/late-interrupt-control.token"
late_interrupt_control_eof="$tmp/late-interrupt-control.eof"
late_interrupt_control_held="$tmp/late-interrupt-control.held"
late_interrupt_control_resumed="$tmp/late-interrupt-control.resumed"
late_interrupt_control_ready="$tmp/late-interrupt-control.ready"
late_interrupt_runtime_root="$tmp/late-interrupt-runtime"
mkdir -p "$late_interrupt_runtime_root"
late_interrupt_exit=0
PATH="$bin:$test_extended_system_path" \
  TMPDIR="$late_interrupt_runtime_root" \
  HOME="$test_home" \
  XDG_STATE_HOME="$test_home/state" \
  ETTUN_CLIENT_ID=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa \
  ETTUN_TEST_TRANSPORT_PID="$late_interrupt_transport_pid" \
  ETTUN_TEST_AUTH_RESULT="$late_interrupt_auth_result" \
  ETTUN_TEST_CONTROL_TOKEN="$late_interrupt_control_token" \
  ETTUN_TEST_CONTROL_EOF="$late_interrupt_control_eof" \
  ETTUN_TEST_CONTROL_HELD="$late_interrupt_control_held" \
  ETTUN_TEST_CONTROL_RESUMED="$late_interrupt_control_resumed" \
  ETTUN_TEST_CONTROL_READY="$late_interrupt_control_ready" \
  ETTUN_TRANSPORT="$bin/interactive-attached-transport" \
  "$test_python" - "$BASH" "$SCRIPT" "$late_interrupt_transport_pid" \
  "$late_interrupt_auth_result" "$late_interrupt_control_resumed" \
  "$late_interrupt_runtime_root" <<'PY'
import fcntl
import os
import pty
import select
import signal
import subprocess
import sys
import termios
import time

bash, script, transport_pid_file, auth_result, resumed_file, runtime_root = sys.argv[1:]

def reap_child(pid, timeout):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        try:
            waited, status = os.waitpid(pid, os.WNOHANG)
        except ChildProcessError:
            return True, None
        if waited:
            return True, status
        time.sleep(0.05)
    return False, None

master, slave = pty.openpty()
child = os.fork()
if child == 0:
    os.setsid()
    fcntl.ioctl(slave, termios.TIOCSCTTY, 0)
    for fd in (0, 1, 2):
        os.dup2(slave, fd)
    os.close(master)
    os.close(slave)
    os.execv(bash, ["bash", script, "gateway.example", "10456", "service.internal", "443"])

os.close(slave)
output = b""
sent = False
status = None
launcher_reaped = False
transport_pid = None
adapter_gone = False
interrupt_injected = False
deadline = time.monotonic() + 15
try:
    while time.monotonic() < deadline:
        readable, _, _ = select.select([master], [], [], 0.1)
        if readable:
            try:
                output += os.read(master, 4096)
            except OSError:
                pass
        if not sent and b"Passcode: " in output:
            os.write(master, b"test-passcode\n")
            sent = True
        if not interrupt_injected and os.path.exists(resumed_file):
            try:
                with open(transport_pid_file, "r", encoding="utf-8") as pid_input:
                    resumed_transport_pid = int(pid_input.read().strip())
            except (FileNotFoundError, ValueError):
                pass
            else:
                runtime_dirs = [
                    os.path.join(runtime_root, entry)
                    for entry in os.listdir(runtime_root)
                    if entry.startswith("ettun.")
                ]
                if runtime_dirs:
                    open(
                        os.path.join(runtime_dirs[0], "transport.interrupted"), "wb"
                    ).close()
                    os.killpg(os.getpgid(resumed_transport_pid), signal.SIGKILL)
                    interrupt_injected = True
        waited, candidate = os.waitpid(child, os.WNOHANG)
        if waited:
            status = candidate
            launcher_reaped = True
            break
    try:
        with open(transport_pid_file, "r", encoding="utf-8") as pid_input:
            transport_pid = int(pid_input.read().strip())
    except (FileNotFoundError, ValueError):
        pass
    if status is not None and transport_pid is not None:
        gone_deadline = time.monotonic() + 2
        while time.monotonic() < gone_deadline:
            state = subprocess.run(
                ["ps", "-o", "stat=", "-p", str(transport_pid)],
                check=False,
                capture_output=True,
                text=True,
            ).stdout.strip()
            if not state or state.startswith("Z"):
                adapter_gone = True
                break
            time.sleep(0.05)
finally:
    if status is None:
        try:
            os.killpg(child, signal.SIGKILL)
        except ProcessLookupError:
            pass
        launcher_reaped, status = reap_child(child, 1)
        if not launcher_reaped:
            try:
                os.kill(child, signal.SIGKILL)
            except ProcessLookupError:
                pass
            launcher_reaped, status = reap_child(child, 1)
    if not adapter_gone and transport_pid is not None:
        try:
            os.killpg(os.getpgid(transport_pid), signal.SIGKILL)
        except ProcessLookupError:
            pass
    os.close(master)

exit_code = os.waitstatus_to_exitcode(status) if status is not None else None
authenticated = False
try:
    with open(auth_result, "r", encoding="utf-8") as auth_input:
        authenticated = auth_input.read().strip() == "test-passcode"
except FileNotFoundError:
    pass
success = (
    sent
    and authenticated
    and os.path.exists(resumed_file)
    and interrupt_injected
    and adapter_gone
    and launcher_reaped
    and exit_code == 130
)
if not success:
    sys.stderr.write(
        f"sent={sent} auth={authenticated} resumed={os.path.exists(resumed_file)} "
        f"injected={interrupt_injected} "
        f"adapter_gone={adapter_gone} reaped={launcher_reaped} exit={exit_code}\n"
    )
    sys.stderr.buffer.write(output)
sys.exit(0 if success else 1)
PY
late_interrupt_exit=$?
_assert_exit "interactive handoff: late transport Ctrl-C returns status 130" \
  0 "$late_interrupt_exit"

echo ""

_test_summary
