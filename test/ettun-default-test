      _fail "default fixture: launch failed or produced a malformed port mapping"
      exit 1
    fi
    stop_remote_port=$(sed -n 's/^ettun_stop_port=//p' \
      <<<"$decoded_remote_command")
    [[ "$stop_remote_port" =~ ^[0-9]+$ ]] || {
      _fail "default fixture: launch produced a malformed stop port"
      exit 1
    }
    if _local_launch_ports_available "$port_scope"; then
      _activate_captured_remote_launch
      return 0
    fi
  done
  _fail "default fixture: could not select an available local remote-control port"
  exit 1
}

