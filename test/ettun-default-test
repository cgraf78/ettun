_local_port_available() {
  "$test_python" - "$1" <<'PY'
import errno
import socket
import sys

probe = None
try:
    probe = socket.socket()
    probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    probe.bind(("127.0.0.1", int(sys.argv[1])))
except OSError as error:
    if error.errno == errno.EADDRINUSE:
        sys.exit(1)
    print(f"port availability probe failed: {error}", file=sys.stderr)
    sys.exit(2)
finally:
    if probe is not None:
        probe.close()
PY
}

_local_port_closed() {
  local probe_exit _

  # A connection probe can consume the one-shot listener and hide a leak.
  # Poll for a successful bind instead, matching the fixture's allocation test.
  for _ in {1..40}; do
    probe_exit=0
    _local_port_available "$1" || probe_exit=$?
    case "$probe_exit" in
      0) return 0 ;;
      1) sleep 0.05 ;;
      *) return "$probe_exit" ;;
    esac
  done
  return 1
}

_ncat_supports_ettun() {
  local help

  command -v ncat >/dev/null 2>&1 || return 1
  help=$(ncat --help 2>&1 || true)
  [[ "$help" == *--listen* && "$help" == *--keep-open* &&
    "$help" == *--sh-exec* && "$help" == *--exec* &&
    "$help" == *--recv-only* ]]
}

_real_relay_available() {
  command -v socat >/dev/null 2>&1 || _ncat_supports_ettun
}

# Some platforms expose OpenBSD netcat under the `ncat` name even though its
# interface is not Nmap Ncat's. Gate the optional real-relay scenarios on the
# flags the generated supervisor actually uses, not merely the executable name.
relay_probe_bin="$tmp/relay-probe-bin"
mkdir -p "$relay_probe_bin"
_write_stub "$relay_probe_bin/ncat" \
  'printf "%s\n" "--listen --keep-open --sh-exec --exec --recv-only"'
if PATH="$relay_probe_bin:$test_system_path" _ncat_supports_ettun; then
  _pass "relay capability: accepts the Nmap Ncat interface"
else
  _fail "relay capability: accepts the Nmap Ncat interface"
fi
_write_stub "$relay_probe_bin/ncat" 'printf "%s\n" "usage: nc [-l]"'
if PATH="$relay_probe_bin:$test_system_path" _ncat_supports_ettun; then
  _fail "relay capability: rejects an OpenBSD netcat alias"
else
  _pass "relay capability: rejects an OpenBSD netcat alias"
fi

_capture_default_launch() {
  local local_port="${1:-10443}"
  _run_ettun gateway.example "$local_port" service.internal 443
  commands=$(cat "$log")
  transport_remote_command=$(cat "$remote_command_file")
  transport_remote_payload=$(cat "$bootstrap_payload_file")
  decoded_remote_command=$(_decode_remote_payload "$transport_remote_payload")
  commands+=$'\n'"$decoded_remote_command"
  output=$(cat "$stdout")
  mapping=$(sed -n '/^<-t>$/{n;s/^<\(.*\)>$/\1/p;q;}' "$log")
  ports=$(sed -n "s/^$local_port:\([0-9][0-9]*\),\([0-9][0-9]*\):\([0-9][0-9]*\)$/\1 \2 \3/p" <<<"$mapping")
  read -r relay_port control_local_port control_remote_port <<<"$ports"
}

_activate_captured_remote_launch() {
  remote_transport_command="$transport_remote_command"
  remote_command="$decoded_remote_command"
  stop_remote_port=$(sed -n 's/^ettun_stop_port=//p' <<<"$remote_command")
  remote_token=$(sed -n 's/^ettun_token=//p' <<<"$remote_command")
  if [[ ! "$stop_remote_port" =~ ^[0-9]+$ ||
    ! "$remote_token" =~ ^[0-9a-f]{32}$ ]]; then
    _fail "default fixture: decoded launch has malformed identity or ports"
    exit 1
  fi
  bootstrap_dir="${TMPDIR:-/tmp}/ettun-bootstrap.$remote_token"
  if [[ -e "$bootstrap_dir" || -L "$bootstrap_dir" ]]; then
    _fail "default fixture: generated bootstrap path already exists"
    exit 1
  fi
  # The fixture pins TMPDIR beneath the guarded suite root.  The harness EXIT
  # trap therefore removes this path even if a bootstrap assertion exits before
  # the generated supervisor performs its own normal cleanup.
}

_local_launch_ports_available() {
  local port_scope="$1" port probe_exit
  local -a ports=("$control_remote_port")
  case "$port_scope" in
    control) ;;
    all) ports+=("$relay_port" "$stop_remote_port") ;;
    *)
      _fail "default fixture: unknown local port scope: $port_scope"
      exit 1
      ;;
  esac
  for port in "${ports[@]}"; do
    probe_exit=0
    _local_port_available "$port" || probe_exit=$?
    case "$probe_exit" in
      0) ;;
      1) return 1 ;;
      *)
        _fail "default fixture: could not probe local port $port"
        exit 1
        ;;
    esac
  done
  return 0
}

# The generated control port is remote in production, but this fixture runs the
# remote command locally. Select immediately before each real local bind so an
# unrelated listener cannot turn remote-port selection into a test failure.
_select_local_remote_launch() {
  local local_port="${1:-10443}" port_scope="${2:-control}" _
  for _ in {1..20}; do
    _capture_default_launch "$local_port"
    if [[ "$run_exit" -ne 0 || ! "$relay_port" =~ ^[0-9]+$ ||
      ! "$control_local_port" =~ ^[0-9]+$ ||
      ! "$control_remote_port" =~ ^[0-9]+$ ]]; then
      _fail "default fixture: launch failed or produced a malformed port mapping"
      exit 1
    fi
    stop_remote_port=$(sed -n 's/^ettun_stop_port=//p' \
      <<<"$decoded_remote_command")
    [[ "$stop_remote_port" =~ ^[0-9]+$ ]] || {
      _fail "default fixture: launch produced a malformed stop port"
      exit 1
    }
    if _local_launch_ports_available "$port_scope"; then
      _activate_captured_remote_launch
      return 0
    fi
  done
  _fail "default fixture: could not select an available local remote-control port"
  exit 1
}

