_local_port_available() {
  "$test_python" - "$1" <<'PY'
import errno
import socket
import sys

probe = None
try:
    probe = socket.socket()
    probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    probe.bind(("127.0.0.1", int(sys.argv[1])))
except OSError as error:
    if error.errno == errno.EADDRINUSE:
        sys.exit(1)
    print(f"port availability probe failed: {error}", file=sys.stderr)
    sys.exit(2)
finally:
    if probe is not None:
        probe.close()
PY
}

_local_port_closed() {
  local probe_exit _

  # A connection probe can consume a one-shot listener and hide a leak, so
  # poll for a successful bind for the whole budget. A refused bind alone is
  # not a leak: an unrelated outgoing connection can reuse the port as soon
  # as the listener closes. Only after the budget does one connection
  # attempt decide: refused means no listener remains.
  local deadline=$((SECONDS + WAIT_DEADLINE_SECONDS))
  while ((SECONDS < deadline)); do
    probe_exit=0
    _local_port_available "$1" || probe_exit=$?
    case "$probe_exit" in
      0) return 0 ;;
      1) sleep 0.05 ;;
      *) return "$probe_exit" ;;
    esac
  done
  ! _local_port_listening "$1"
}

_local_port_listening() {
  "$test_python" - "$1" <<'PY'
import os
import socket
import sys

scale = float(os.environ.get("ETTUN_TEST_TIME_SCALE", "1"))
try:
    socket.create_connection(("127.0.0.1", int(sys.argv[1])), timeout=scale).close()
except OSError:
    sys.exit(1)
PY
}

# Print a currently free loopback port below the default ephemeral ranges of
# Linux and Android (32768+) and macOS and BSD (49152+), so on such hosts no
# outgoing connection can claim it between this check and the bind a case
# makes later. Only a new listener could, and the random choice makes that a
# negligible collision.
_free_port() {
  "$test_python" - <<'PY'
import errno
import random
import socket
import sys


def bindable(family, host, port):
    try:
        probe = socket.socket(family)
    except OSError:
        return True
    try:
        probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        if family == socket.AF_INET6:
            probe.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 1)
        probe.bind((host, port))
        probe.listen(1)
    except OSError as error:
        # Without IPv6 loopback only the IPv4 answer matters.
        return family == socket.AF_INET6 and error.errno != errno.EADDRINUSE
    finally:
        probe.close()
    return True


for _ in range(200):
    port = random.randint(20000, 29999)
    if bindable(socket.AF_INET, "127.0.0.1", port) and bindable(
        socket.AF_INET6, "::1", port
    ):
        print(port)
        sys.exit(0)
sys.exit(1)
PY
}

_ipv6_loopback_available() {
  "$test_python" -c '
import socket
probe = socket.socket(socket.AF_INET6)
probe.bind(("::1", 0))
probe.close()
' 2>/dev/null
}

# Leave one loopback TCP endpoint in TIME-WAIT and print its port. "client"
# models an outgoing connection, such as an `nc -z` health check, whose source
# port is PORT (or an ephemeral one) and which closes first without
# SO_REUSEADDR. "server" models a just-stopped SO_REUSEADDR listener that
# closed its accepted connection first. Exit 3 means PORT was already taken.
_make_time_wait() {
  "$test_python" - "$1" "${2:-0}" <<'PY'
import errno
import os
import socket
import sys

side, port = sys.argv[1], int(sys.argv[2])
server = socket.socket()
server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
client = socket.socket()
try:
    if side == "server":
        server.bind(("127.0.0.1", port))
    else:
        server.bind(("127.0.0.1", 0))
        if port:
            client.bind(("127.0.0.1", port))
except OSError as error:
    if error.errno == errno.EADDRINUSE:
        sys.exit(3)
    raise
server.listen(1)
if side == "server":
    client.connect(server.getsockname())
    accepted, _ = server.accept()
    held = server.getsockname()[1]
    first, second = accepted, client
else:
    client.connect(server.getsockname())
    accepted, _ = server.accept()
    held = client.getsockname()[1]
    first, second = client, accepted
first.close()
# Wait for the first closer's FIN so that side, not its peer, ends in TIME-WAIT.
second.settimeout(float(os.environ.get("ETTUN_TEST_WAIT_SECONDS", "20")))
second.recv(1)
second.close()
server.close()
print(held)
PY
}

# Holds a requested port for the losing-transport stub. By default it is bound
# without SO_REUSEADDR and not listening, so ettun's control helper is refused
# at once instead of stalling on an accepted connection that never answers.
# "listen" instead uses a SO_REUSEADDR listener, which can still claim a port
# whose previous listener left TIME-WAIT behind; it closes every connection
# it accepts so ettun's helper never waits on it.
_start_port_occupier() {
  local occupy_mode=${1:-bind}

  occupy_request="$tmp/occupy-request"
  occupy_ack="$tmp/occupy-ack"
  occupy_stop="$tmp/occupy-stop"
  occupy_state="$tmp/occupy-state"
  rm -f "$occupy_request" "$occupy_ack" "$occupy_ack.failed" "$occupy_stop" \
    "$occupy_state"
  "$test_python" - "$occupy_request" "$occupy_ack" "$occupy_stop" \
    "$occupy_mode" <<'PY' &
import os
import socket
import sys
import time

request, ack, stop, mode = sys.argv[1:]
# The losing-transport stub waits three shared bounds for the acknowledgement.
deadline = time.monotonic() + 3 * float(os.environ.get("ETTUN_TEST_WAIT_SECONDS", "20"))
while not os.path.exists(request) and not os.path.exists(stop):
    if time.monotonic() >= deadline:
        sys.exit(1)
    time.sleep(0.01)
if os.path.exists(stop):
    sys.exit(0)
with open(request, encoding="utf-8") as source:
    port = int(source.read())
holder = socket.socket()
if mode == "listen":
    holder.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
try:
    holder.bind(("127.0.0.1", port))
except OSError:
    # Host traffic took the port first; the stub reports a missed
    # precondition and the case retries with fresh ports.
    open(ack + ".failed", "wb").close()
    sys.exit(0)
if mode == "listen":
    holder.listen(8)
    holder.settimeout(0.01)
open(ack, "wb").close()
# A fresh deadline bounds the hold independently of how long the request took.
deadline = time.monotonic() + 6 * float(os.environ.get("ETTUN_TEST_WAIT_SECONDS", "20"))
while not os.path.exists(stop) and time.monotonic() < deadline:
    if mode == "listen":
        try:
            holder.accept()[0].close()
        except OSError:
            pass
    else:
        time.sleep(0.01)
holder.close()
PY
  occupier_pid=$!
}

_stop_port_occupier() {
  : >"$occupy_stop"
  wait "$occupier_pid" 2>/dev/null || true
}

# Run ettun with the losing-transport stub in ROLE, after starting an
# occupier in OCCUPY_MODE ("none" for no occupier). Extra NAME=VALUE
# arguments are exported for that run only. When host traffic already held a
# port the scenario needed, the stub reports a missed precondition; retry
# with fresh ports so the assertions only ever see a valid scenario.
_run_losing() {
  local role="$1" occupy_mode="$2" probe_path="$3" assignment _
  shift 3

  for _ in 1 2 3 4 5 6 7 8; do
    if [[ $occupy_mode == none ]]; then
      occupy_request="$tmp/occupy-request"
      occupy_ack="$tmp/occupy-ack"
      occupy_state="$tmp/occupy-state"
      rm -f "$occupy_request" "$occupy_ack" "$occupy_ack.failed" \
        "$occupy_state"
    else
      _start_port_occupier "$occupy_mode"
    fi
    for assignment in "$@"; do
      export "${assignment?}"
    done
    free_port=$(_free_port)
    ETTUN_TEST_PATH="$probe_path" \
      ETTUN_TEST_TRANSPORT="$bin/losing-transport" \
      ETTUN_TEST_OCCUPY_ROLE="$role" \
      ETTUN_TEST_OCCUPY_REQUEST="$occupy_request" \
      ETTUN_TEST_OCCUPY_ACK="$occupy_ack" \
      ETTUN_TEST_OCCUPY_STATE="$occupy_state" \
      _run_ettun gateway.example "$free_port" service.internal 443
    for assignment in "$@"; do
      unset "${assignment%%=*}"
    done
    [[ $occupy_mode == none ]] || _stop_port_occupier
    grep -q 'losing-transport: precondition missed' "$stderr" || return 0
  done
  _fail "losing transport [$role]: host traffic held its ports on every attempt"
  return 1
}

# Run ettun's bind-probe cases with one probe implementation on PATH. Every
# case uses a real loopback socket; ETTUN_TEST_LSOF_EXIT=1 makes the stubbed
# socket tables report every port free, so only the bind probe can reject one.
_bind_probe_cases() {
  local probe_path="$2" label="bind probe [$1]"
  local held_port_file held_port_pid held_port time_wait_port time_wait_bind
  local time_wait_expected free_port probe_slot first_control make_status
  local hidden_expected
  local probe_mapping probe_control lost_control lost_mappings
  local lost_retry_mapping

  export ETTUN_TEST_LSOF_EXIT=1

  held_port_file="$tmp/probe-held-port"
  rm -f "$held_port_file"
  "$test_python" - "$held_port_file" <<'PY' &
import os
import socket
import sys
import time

holder = socket.socket()
holder.bind(("127.0.0.1", 0))
# This holder never accepts, so every completed connection stays queued.
# The case connects once to set its expectation and ettun connects again.
# On macOS a backlog of one was already full after the first, so ettun's
# `nc -z` timed out and saw no listener; Linux admits one extra connection.
holder.listen(16)
with open(sys.argv[1], "w", encoding="utf-8") as output:
    output.write(f"{holder.getsockname()[1]}\n")
# Killed by the case; the backstop only bounds an aborted run.
time.sleep(3 * float(os.environ.get("ETTUN_TEST_WAIT_SECONDS", "20")))
PY
  held_port_pid=$!
  if _wait_for_file "$held_port_file"; then
    read -r held_port <"$held_port_file"
    # With the socket tables blind to it (as for another user's socket under
    # non-root lsof), the refused bind still stops the launch, and a
    # connection check identifies a lasting listener rather than a closing
    # connection. Without a working `nc -z` only the temporary-failure
    # answer is possible.
    hidden_expected=75
    if PATH="$probe_path" nc -z -w "$ETTUN_TEST_TIME_SCALE" 127.0.0.1 "$held_port" \
      </dev/null >/dev/null 2>&1; then
      hidden_expected=1
    fi
    ETTUN_TEST_PATH="$probe_path" ETTUN_TEST_EXIT=23 \
      _run_ettun gateway.example "$held_port" service.internal 443
    _assert_exit "$label: listener hidden from socket tables is rejected" \
      "$hidden_expected" "$run_exit"
    _assert_file_content "$label: hidden listener rejected before transport" \
      "" "$log"
    ETTUN_TEST_PATH="$probe_path" ETTUN_TEST_EXIT=23 \
      ETTUN_TEST_LSOF_EXIT='' ETTUN_TEST_LSOF_ESTABLISHED_PORT="$held_port" \
      _run_ettun gateway.example "$held_port" service.internal 443
    _assert_exit "$label: owned live listener rejected" 1 "$run_exit"
    _assert_contains "$label: owned live listener suggests an existing tunnel" \
      "may already be running" "$(<"$stderr")"
    _assert_file_content "$label: owned live listener rejected before transport" \
      "" "$log"
  else
    _fail "$label: holder binds a loopback listener"
  fi
  kill "$held_port_pid" 2>/dev/null || true
  wait "$held_port_pid" 2>/dev/null || true

  # Linux rejects a SO_REUSEADDR bind over an outgoing TIME-WAIT that did not
  # set SO_REUSEADDR; BSD and macOS allow it. Compare with a real bind so the
  # probe is held to whatever the listener itself would see on this host. No
  # process owns that TIME-WAIT, so ettun reports a temporary failure.
  if time_wait_port=$(_make_time_wait client); then
    time_wait_bind=0
    _local_port_available "$time_wait_port" || time_wait_bind=$?
    if [[ $(uname -s) == Linux ]]; then
      _assert_exit "$label: outgoing TIME-WAIT blocks a Linux listener" \
        1 "$time_wait_bind"
    fi
    time_wait_expected=23
    ((time_wait_bind != 1)) || time_wait_expected=75
    ETTUN_TEST_PATH="$probe_path" ETTUN_TEST_EXIT=23 \
      _run_ettun gateway.example "$time_wait_port" service.internal 443
    _assert_exit "$label: outgoing TIME-WAIT matches a real bind" \
      "$time_wait_expected" "$run_exit"
    if ((time_wait_bind == 1)); then
      _assert_contains "$label: outgoing TIME-WAIT is reported as temporary" \
        "retry within about a minute" "$(<"$stderr")"
      _assert_file_content "$label: outgoing TIME-WAIT rejected before transport" \
        "" "$log"
    fi
  else
    _fail "$label: fixture leaves an outgoing TIME-WAIT"
  fi

  if time_wait_port=$(_make_time_wait server); then
    ETTUN_TEST_PATH="$probe_path" ETTUN_TEST_EXIT=23 \
      _run_ettun gateway.example "$time_wait_port" service.internal 443
    _assert_exit "$label: stopped listener's TIME-WAIT allows a restart" \
      23 "$run_exit"
  else
    _fail "$label: fixture leaves a listener TIME-WAIT"
  fi

  free_port=$(_free_port)
  ETTUN_TEST_PATH="$probe_path" ETTUN_TEST_EXIT=23 \
    _run_ettun gateway.example "$free_port" service.internal 443
  _assert_exit "$label: free port reaches the transport" 23 "$run_exit"

  # A successful 127.0.0.1 bind is not final: a ::1 or wildcard listener seen
  # only in the socket tables (here, the lsof stub) still owns the port.
  free_port=$(_free_port)
  ETTUN_TEST_PATH="$probe_path" ETTUN_TEST_LSOF_EXIT=0 ETTUN_TEST_EXIT=23 \
    _run_ettun gateway.example "$free_port" service.internal 443
  _assert_exit "$label: successful bind still defers to socket tables" 1 \
    "$run_exit"
  _assert_file_content "$label: socket-table owner rejected before transport" \
    "" "$log"

  # ettun prefers one parity for control ports (see preferred_parity), and
  # for a slot of that parity the first preferred candidate is palette four.
  # Use slots no other case touches, because the TIME-WAIT outlives this
  # suite's run; each mode and each repeated run within a minute walks on.
  probe_slot=''
  while ((probe_slot_cursor < 800)); do
    first_control=$((49152 + 4 * 819 + probe_slot_cursor))
    make_status=0
    time_wait_port=$(_make_time_wait client "$first_control") ||
      make_status=$?
    probe_slot_cursor=$((probe_slot_cursor + 2))
    case $make_status in
      0)
        probe_slot=$((probe_slot_cursor - 2))
        break
        ;;
      3) ;;
      *)
        _fail "$label: fixture leaves a slot control candidate in TIME-WAIT"
        break
        ;;
    esac
  done
  if [[ -n $probe_slot ]]; then
    time_wait_bind=0
    _local_port_available "$first_control" || time_wait_bind=$?
    if [[ $(uname -s) == Linux ]]; then
      _assert_exit "$label: slot candidate TIME-WAIT blocks a Linux listener" \
        1 "$time_wait_bind"
    fi
    free_port=$(_free_port)
    ETTUN_REMOTE_PORT_SLOT_V1=$probe_slot ETTUN_TEST_PATH="$probe_path" \
      _run_ettun gateway.example "$free_port" service.internal 443
    probe_mapping=$(sed -n '/^<-t>$/{n;s/^<\(.*\)>$/\1/p;q;}' "$log")
    probe_control=${probe_mapping##*,}
    probe_control=${probe_control%%:*}
    _assert_exit "$label: slotted launch succeeds" 0 "$run_exit"
    if [[ $probe_control =~ ^[0-9]+$ ]] &&
      ((probe_control >= 49152 && (\
      probe_control - 49152) % 819 == probe_slot)); then
      _pass "$label: local control port stays in its remote port slot"
    else
      _fail "$label: local control port stays in its remote port slot (got '$probe_mapping')"
    fi
    if ((time_wait_bind == 1)); then
      if [[ $probe_control != "$first_control" ]]; then
        _pass "$label: control selection skips a TIME-WAIT candidate"
      else
        _fail "$label: control selection skips a TIME-WAIT candidate"
      fi
    fi
    if [[ $probe_control =~ ^[0-9]+$ ]] &&
      ((probe_control % 2 == preferred_parity)); then
      _pass "$label: control selection prefers the parity connect() avoids"
    else
      _fail "$label: control selection prefers the parity connect() avoids (got '$probe_control')"
    fi
  elif [[ $(uname -s) == Linux ]]; then
    _fail "$label: no free slot control candidate for a TIME-WAIT fixture"
  else
    printf '  SKIP: %s: no free slot control candidate for a TIME-WAIT fixture\n' \
      "$label"
  fi

  _run_losing control bind "$probe_path"
  lost_control=$(cat "$occupy_request" 2>/dev/null)
  lost_mappings=$(sed -n '/^losing$/{n;p;}' "$log")
  _assert_exit "$label: lost control port retries to success" 0 "$run_exit"
  _assert_eq "$label: lost control port reinvokes the adapter once" \
    2 "$(grep -c '^losing$' "$log")"
  _assert_contains "$label: lost control port diagnostic names the port" \
    "local control port 127.0.0.1:$lost_control is now in use" "$(<"$stderr")"
  _assert_contains "$label: lost control port reports the retry" \
    "was busy; retrying (2/5)" "$(<"$stderr")"
  lost_retry_mapping=$(sed -n 2p <<<"$lost_mappings")
  if [[ -n $lost_retry_mapping && $lost_retry_mapping != *",$lost_control:"* ]]; then
    _pass "$label: lost control port retry selects another control port"
  else
    _fail "$label: lost control port retry selects another control port (got '$lost_mappings')"
  fi

  _run_losing control bind "$probe_path" ETTUN_TRANSPORT_SINGLE_INVOCATION_V1=1
  lost_control=$(cat "$occupy_request" 2>/dev/null)
  _assert_exit "$label: single-invocation lost control port fails retryably" \
    75 "$run_exit"
  _assert_eq "$label: single-invocation lost control port is not reinvoked" \
    1 "$(grep -c '^losing$' "$log")"
  _assert_contains "$label: single-invocation lost control port names the port" \
    "local control port 127.0.0.1:$lost_control is now in use" "$(<"$stderr")"
  _assert_contains "$label: single-invocation lost control port asks for a rerun" \
    "rerun the command that owns this tunnel" "$(<"$stderr")"

  # A listener left on the control port after the transport failed is more
  # likely the transport's own leftover forward than the race a retry exists
  # for, so ettun names it and keeps the transport status.
  _run_losing control listen "$probe_path" \
    ETTUN_TEST_LSOF_LISTENER_FILE="$tmp/occupy-request"
  lost_control=$(cat "$occupy_request" 2>/dev/null)
  _assert_exit "$label: listener on the control port preserves the status" 1 \
    "$run_exit"
  _assert_eq "$label: listener on the control port is not retried" \
    1 "$(grep -c '^losing$' "$log")"
  _assert_contains "$label: listener on the control port is named" \
    "127.0.0.1:$lost_control is held by a listener" "$(<"$stderr")"

  # The dead transport's own closing connections still appear in the socket
  # tables; only a refused bind may classify the control port as lost.
  _run_losing linger none "$probe_path" \
    ETTUN_TEST_LSOF_OWNER_FILE="$tmp/occupy-request"
  _assert_exit "$label: lingering connection preserves the transport status" 1 \
    "$run_exit"
  _assert_eq "$label: lingering connection is not retried" \
    1 "$(grep -c '^losing$' "$log")"
  _assert_not_contains "$label: lingering connection has no diagnostic" \
    "is now in use" "$(<"$stderr")"

  # A transport whose listener lacks SO_REUSEADDR and closes ettun's control
  # connection first leaves its own TIME-WAIT; having reached that listener,
  # ettun must not mistake the refused bind for a lost port.
  _run_losing early-close none "$probe_path"
  _assert_exit "$label: transport's own TIME-WAIT preserves the status" 1 \
    "$run_exit"
  _assert_eq "$label: transport's own TIME-WAIT is not retried" \
    1 "$(grep -c '^losing$' "$log")"
  _assert_contains "$label: transport's own TIME-WAIT follows a connection" \
    "closed" "$(cat "$occupy_state" 2>/dev/null)"
  _assert_not_contains "$label: transport's own TIME-WAIT has no diagnostic" \
    "is now in use" "$(<"$stderr")"

  _run_losing local bind "$probe_path"
  _assert_exit "$label: lost local port preserves the transport status" 1 \
    "$run_exit"
  _assert_eq "$label: lost local port is not retried" \
    1 "$(grep -c '^losing$' "$log")"
  _assert_contains "$label: lost local port diagnostic names the port" \
    "localhost:$free_port is now in use" "$(<"$stderr")"

  _run_losing control bind "$probe_path" ETTUN_TEST_OCCUPY_EXIT=0
  _assert_exit "$label: lost control port after success keeps the success" 0 \
    "$run_exit"
  _assert_eq "$label: lost control port after success is not reinvoked" \
    1 "$(grep -c '^losing$' "$log")"
  _assert_not_contains "$label: lost control port after success has no diagnostic" \
    "is now in use" "$(<"$stderr")"

  # Once a session attached, the transport's own listener was proven, so a
  # port taken afterwards must not reinvoke (and reauthenticate) the adapter.
  _run_losing attached listen "$probe_path"
  _assert_exit "$label: lost control port after attachment preserves the status" \
    1 "$run_exit"
  _assert_eq "$label: lost control port after attachment is not reinvoked" \
    1 "$(grep -c '^losing$' "$log")"
  _assert_file_exists "$label: lost control port after attachment was taken" \
    "$occupy_ack"
  _assert_not_contains "$label: lost control port after attachment has no diagnostic" \
    "is now in use" "$(<"$stderr")"
  _assert_not_contains "$label: lost control port after attachment names no listener" \
    "held by a listener" "$(<"$stderr")"

  # ET binds localhost on both families and keeps whichever succeeds. When a
  # socket claims 127.0.0.1 between ettun's probe and that bind, the tunnel
  # must still attach over ::1, on the first invocation, instead of waiting
  # for 127.0.0.1 forever.
  if _ipv6_loopback_available; then
    _run_losing et none "$probe_path"
    _assert_exit "$label: control port lost on 127.0.0.1 still attaches" 0 \
      "$run_exit"
    _assert_eq "$label: control port lost on 127.0.0.1 needs one invocation" \
      1 "$(grep -c '^losing$' "$log")"
    _assert_contains "$label: control port lost on 127.0.0.1 completes the handshake" \
      "attached" "$(cat "$occupy_state" 2>/dev/null)"
    if [[ $(uname -s) == Linux ]]; then
      _assert_eq "$label: control port lost on 127.0.0.1 attaches over ::1" \
        $'bound ::1\nattached' "$(cat "$occupy_state" 2>/dev/null)"
    fi
  else
    printf '  SKIP: %s: ::1 control fallback requires IPv6 loopback\n' "$label"
  fi

  _run_losing "" none "$probe_path" ETTUN_TEST_EXIT=1
  _assert_exit "$label: free ports after failure preserve the transport status" \
    1 "$run_exit"
  _assert_eq "$label: free ports after failure are not retried" \
    1 "$(grep -c '^losing$' "$log")"
  _assert_not_contains "$label: free ports after failure have no diagnostic" \
    "is now in use" "$(<"$stderr")"

  unset ETTUN_TEST_LSOF_EXIT
}

