#!/usr/bin/env bash

set -uo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

# shellcheck source=lib/test.sh
. "$ROOT/test/lib/test.sh"

printf '=== ettun installation ===\n'

wrapper="$ROOT/install.sh"
delegate="$ROOT/support/install-checkout.sh"

_assert_file_exists "installation: generated checkout wrapper is present" \
  "$wrapper"
_assert_file_exists "installation: checkout-owned delegate is present" \
  "$delegate"
_assert_contains "installation: wrapper identifies the shared generator" \
  "Generated by cgraf78/actions checkout-installer" \
  "$(sed -n '2p' "$wrapper")"
if [[ ! -f "$wrapper" || ! -f "$delegate" ]]; then
  _test_summary
fi

prefix=$(_tmpdir)
PREFIX="$prefix" "$wrapper" >/dev/null
install_status=$?
_assert_exit "installation: direct wrapper succeeds" 0 "$install_status"
_assert_eq "installation: publishes the checkout command" \
  "$ROOT/bin/ettun" "$(readlink "$prefix/bin/ettun")"
runtime_status=0
runtime_output=$("$prefix/bin/ettun" --help 2>&1) || runtime_status=$?
_assert_exit "installation: direct command exits successfully" 0 \
  "$runtime_status"
_assert_contains "installation: direct command executes from the checkout" \
  "Usage: ettun" "$runtime_output"

PREFIX="$prefix" "$wrapper" >/dev/null
install_status=$?
_assert_exit "installation: reinstall succeeds" 0 "$install_status"
_assert_eq "installation: reinstall is idempotent" \
  "$ROOT/bin/ettun" "$(readlink "$prefix/bin/ettun")"

custom_bin=$(_tmpdir)/commands
BIN_DIR="$custom_bin" "$delegate" >/dev/null
install_status=$?
_assert_exit "installation: custom BIN_DIR succeeds" 0 "$install_status"
_assert_eq "installation: honors BIN_DIR" \
  "$ROOT/bin/ettun" "$(readlink "$custom_bin/ettun")"

blocked_bin=$(_tmpdir)/commands
mkdir -p "$blocked_bin"
printf 'owned elsewhere\n' >"$blocked_bin/ettun"
blocked_status=0
blocked_output=$(BIN_DIR="$blocked_bin" "$delegate" 2>&1) ||
  blocked_status=$?
_assert_exit "installation: refuses a non-symlink destination" 1 \
  "$blocked_status"
_assert_file_content "installation: preserves a non-symlink destination" \
  "owned elsewhere" "$blocked_bin/ettun"
_assert_contains "installation: destination refusal is actionable" \
  "refusing to replace non-symlink" "$blocked_output"

missing_root=$(_tmpdir)
missing_prefix=$(_tmpdir)
mkdir -p "$missing_root/support"
cp "$delegate" "$missing_root/support/install-checkout.sh"
missing_status=0
missing_output=$(PREFIX="$missing_prefix" \
  "$missing_root/support/install-checkout.sh" 2>&1) ||
  missing_status=$?
_assert_exit "installation: missing command source fails" 1 "$missing_status"
if [[ ! -e "$missing_prefix/bin/ettun" &&
  ! -L "$missing_prefix/bin/ettun" ]]; then
  _pass "installation: missing source publishes no command"
else
  _fail "installation: missing source publishes no command"
fi
_assert_contains "installation: missing source is actionable" \
  "command source is not executable" "$missing_output"

curl_source=$(_tmpdir)
curl_source=$(cd -P -- "$curl_source" && pwd -P)
curl_remote_root=$(_tmpdir)
curl_remote_root=$(cd -P -- "$curl_remote_root" && pwd -P)
curl_remote="$curl_remote_root/ettun.git"
curl_checkout_root=$(_tmpdir)
curl_checkout_root=$(cd -P -- "$curl_checkout_root" && pwd -P)
curl_checkout="$curl_checkout_root/managed/ettun"
curl_prefix=$(_tmpdir)
curl_prefix=$(cd -P -- "$curl_prefix" && pwd -P)
mkdir -p "$curl_source"
cp "$wrapper" "$curl_source/install.sh"
cp -R "$ROOT/bin" "$ROOT/support" "$curl_source/"
git -C "$curl_source" init --quiet --initial-branch=main --template=''
git -C "$curl_source" config core.hooksPath /dev/null
git -C "$curl_source" config commit.gpgsign false
git -C "$curl_source" config user.name 'Ettun Installer Test'
git -C "$curl_source" config user.email ettun-installer@example.invalid
git -C "$curl_source" add .
git -C "$curl_source" commit --quiet -m 'checkout installer fixture'
git init --quiet --bare --initial-branch=main "$curl_remote"
git -C "$curl_source" remote add origin "$curl_remote"
git -C "$curl_source" push --quiet --set-upstream origin main

direct_prefix=$(_tmpdir)
PREFIX="$direct_prefix" "$curl_source/install.sh" >/dev/null
install_status=$?
_assert_exit "installation: fixture direct wrapper succeeds" 0 \
  "$install_status"
_assert_eq "installation: direct wrapper selects its physical checkout" \
  "$curl_source/bin/ettun" "$(readlink "$direct_prefix/bin/ettun")"
direct_runtime_status=0
direct_runtime_output=$("$direct_prefix/bin/ettun" --help 2>&1) ||
  direct_runtime_status=$?
_assert_exit "installation: fixture direct command exits successfully" 0 \
  "$direct_runtime_status"
_assert_contains "installation: direct wrapper publishes a working command" \
  "Usage: ettun" "$direct_runtime_output"

curl_output_file="$curl_prefix/bootstrap.out"
curl --fail --silent --show-error "file://$curl_source/install.sh" |
  PREFIX="$curl_prefix" \
    CGRAF78_CHECKOUT_INSTALL_DIR="$curl_checkout" \
    CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$curl_remote" \
    bash -s >"$curl_output_file" 2>&1
pipeline_status=("${PIPESTATUS[@]}")
_assert_exit "installation: curl bootstrap source succeeds" 0 \
  "${pipeline_status[0]}"
_assert_exit "installation: piped bootstrap succeeds" 0 \
  "${pipeline_status[1]}"
curl_output=$(<"$curl_output_file")
curl_checkout_physical=$(cd -P -- "$curl_checkout" && pwd -P)
_assert_file_exists "installation: curl bootstrap keeps a durable checkout" \
  "$curl_checkout/.git/HEAD"
_assert_eq "installation: curl command selects the managed checkout" \
  "$curl_checkout_physical/bin/ettun" \
  "$(readlink "$curl_prefix/bin/ettun")"
curl_runtime_status=0
curl_runtime_output=$("$curl_prefix/bin/ettun" --help 2>&1) ||
  curl_runtime_status=$?
_assert_exit "installation: curl-installed command exits successfully" 0 \
  "$curl_runtime_status"
_assert_contains "installation: curl bootstrap publishes a working command" \
  "Usage: ettun" "$curl_runtime_output"
_assert_contains "installation: curl bootstrap reports its durable clone" \
  "cloning cgraf78/ettun to $curl_checkout_physical" "$curl_output"

_test_summary
